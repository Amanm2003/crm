<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_agency" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.agency</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_agency_order"/>
                <field name="x_agency_id" invisible="not x_agency_order"
                       required="x_agency_order"/>
            </field>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_agency" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.agency</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_agency_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>

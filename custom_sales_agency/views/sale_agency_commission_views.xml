    <record id="action_sale_agency_commission" model="ir.actions.act_window">
        <field name="name">Commission Records</field>
        <field name="res_model">sale.agency.commission</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                Commission records are created automatically when a Customer
                Invoice linked to an Agency Order is posted.
            </p>
        </field>
    </record>
    <record id="action_commission_due" model="ir.actions.act_window">
        <field name="name">Commission Due</field>
        <field name="res_model">sale.agency.commission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','payment_received')]</field>
    </record>
    <record id="action_commission_paid" model="ir.actions.act_window">
        <field name="name">Commission Paid</field>
        <field name="res_model">sale.agency.commission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','commission_paid')]</field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Agency field is shown ONLY on the Odoo form view (backend), never on
         the printed invoice/credit note report. See
         report/account_invoice_report_inherit.xml for the (deliberately
         empty) print-template note. -->
    <record id="view_move_form_inherit_agency" model="ir.ui.view">
        <field name="name">account.move.form.inherit.agency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="x_agency_id"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </field>
        </field>
    </record>

    <record id="action_agency_vendor_bills" model="ir.actions.act_window">
        <field name="name">Agency Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [('x_agency_id','!=',False)]
        </field>
        <field name="context">
            {'default_move_type':'in_invoice'}
        </field>
    </record>

</odoo>
